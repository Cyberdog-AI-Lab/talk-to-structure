{
  "meta": {
    "title": "ライブハウス予約管理システム",
    "description": "イベント企画・バンドブッキング・チケット販売・出演バンドとの精算・スタッフシフトを一元管理するシステム"
  },
  "entities": [
    {
      "id": "event",
      "label": "イベント",
      "type": "transaction",
      "description": "ライブハウスが企画・開催する1公演。日程・会場・タイトルを持ち、出演バンド・チケット販売・スタッフシフトはすべてこのイベントに紐づく。",
      "attributes": [
        { "name": "イベントID", "pk": true, "description": "イベントを一意に識別するID" },
        { "name": "タイトル", "required": true, "description": "公演のタイトル・イベント名" },
        { "name": "開催日時", "required": true, "description": "公演が開催される日付と開演時刻" },
        { "name": "会場名", "required": true, "description": "公演を行うライブハウスの名称" }
      ]
    },
    {
      "id": "band",
      "label": "バンド",
      "type": "master",
      "description": "出演依頼を受けるアーティスト・バンド。バンド名と連絡先を管理し、出演・チケット取り置きはこのバンドに紐づく。",
      "attributes": [
        { "name": "バンドID", "pk": true, "description": "バンドを一意に識別するID" },
        { "name": "バンド名", "required": true, "description": "アーティスト・バンドの名称" },
        { "name": "連絡先", "required": true, "description": "ブッキング連絡に使用するメールアドレスや電話番号" }
      ]
    },
    {
      "id": "performance",
      "label": "出演",
      "type": "junction",
      "description": "イベントとバンドを結ぶ出演記録。出演形態（招待またはノルマ）・ノルマ金額・報酬額を管理する。",
      "attributes": [
        { "name": "出演ID", "pk": true, "description": "出演記録を一意に識別するID" },
        { "name": "イベントID", "fk": { "entity": "event", "attribute": "イベントID" }, "required": true, "description": "どのイベントに出演するかへの参照" },
        { "name": "バンドID", "fk": { "entity": "band", "attribute": "バンドID" }, "required": true, "description": "出演するバンドへの参照" },
        { "name": "出演形態", "required": true, "description": "招待（報酬支払い）またはノルマ（チケット販売義務あり）の区分" },
        { "name": "ノルマ金額", "description": "ノルマ出演の場合に課される最低保証販売金額。招待の場合は空欄。" },
        { "name": "報酬額", "description": "招待出演の場合に支払う報酬。ノルマの場合は空欄。" }
      ]
    },
    {
      "id": "ticket_type",
      "label": "チケット種別",
      "type": "master",
      "description": "チケットの販売チャネルを定義するマスター。直販・eチケット・バンド取り置きの3種類を管理する。",
      "attributes": [
        { "name": "チケット種別ID", "pk": true, "description": "チケット種別を一意に識別するID" },
        { "name": "種別名", "required": true, "description": "販売チャネルの名称（直販・eチケット・取り置き）" },
        { "name": "単価", "required": true, "description": "このチャネルでのチケット1枚あたりの販売価格" }
      ]
    },
    {
      "id": "ticket_sale",
      "label": "チケット販売",
      "type": "junction",
      "description": "イベント・チケット種別・バンドを結ぶ販売記録。チャネル別・バンド別の販売枚数と売上金額を管理する。バンド取り置き以外はバンドIDが空欄。",
      "attributes": [
        { "name": "販売ID", "pk": true, "description": "チケット販売記録を一意に識別するID" },
        { "name": "イベントID", "fk": { "entity": "event", "attribute": "イベントID" }, "required": true, "description": "どのイベントのチケットかへの参照" },
        { "name": "チケット種別ID", "fk": { "entity": "ticket_type", "attribute": "チケット種別ID" }, "required": true, "description": "どの販売チャネルかへの参照" },
        { "name": "バンドID", "fk": { "entity": "band", "attribute": "バンドID" }, "description": "取り置きチケットを管理するバンドへの参照。取り置き以外は空欄。" },
        { "name": "販売枚数", "required": true, "description": "このチャネル・バンドで販売されたチケットの枚数" },
        { "name": "売上金額", "required": true, "description": "販売枚数 × 単価の合計金額" }
      ]
    },
    {
      "id": "staff",
      "label": "スタッフ",
      "type": "master",
      "description": "当日イベントに従事するスタッフ。名前と役割を持ち、シフトを通じて各イベントに紐づく。",
      "attributes": [
        { "name": "スタッフID", "pk": true, "description": "スタッフを一意に識別するID" },
        { "name": "名前", "required": true, "description": "スタッフの氏名" },
        { "name": "役割", "required": true, "description": "ステージ・受付・物販など担当する職種" }
      ]
    },
    {
      "id": "shift",
      "label": "シフト",
      "type": "junction",
      "description": "イベントとスタッフを結ぶシフト記録。担当時間を管理する。",
      "attributes": [
        { "name": "シフトID", "pk": true, "description": "シフト記録を一意に識別するID" },
        { "name": "イベントID", "fk": { "entity": "event", "attribute": "イベントID" }, "required": true, "description": "どのイベントのシフトかへの参照" },
        { "name": "スタッフID", "fk": { "entity": "staff", "attribute": "スタッフID" }, "required": true, "description": "担当するスタッフへの参照" },
        { "name": "担当時間", "required": true, "description": "スタッフが勤務する開始〜終了の時間帯" }
      ]
    }
  ],
  "relations": [
    {
      "id": "r1",
      "from": "event",
      "to": "performance",
      "label": "に出演がある",
      "cardinality": "1:N",
      "description": "1つのイベントに複数のバンドが出演する。各出演はイベントに紐づく。"
    },
    {
      "id": "r2",
      "from": "band",
      "to": "performance",
      "label": "出演する",
      "cardinality": "1:N",
      "description": "1つのバンドが複数のイベントに出演しうる。各出演はバンドに紐づく。"
    },
    {
      "id": "r3",
      "from": "event",
      "to": "ticket_sale",
      "label": "チケットを売る",
      "cardinality": "1:N",
      "description": "1つのイベントで複数の販売チャネル・バンドに分けてチケットを販売する。"
    },
    {
      "id": "r4",
      "from": "ticket_type",
      "to": "ticket_sale",
      "label": "チャネルとして使われる",
      "cardinality": "1:N",
      "description": "同一の販売チャネル（直販・eチケット・取り置き）が複数のイベントで繰り返し使われる。"
    },
    {
      "id": "r5",
      "from": "band",
      "to": "ticket_sale",
      "label": "取り置きを持つ",
      "cardinality": "1:N",
      "description": "バンドの取り置きチケット分はバンドに紐づく。直販・eチケットにはバンドの紐づけがない。"
    },
    {
      "id": "r6",
      "from": "event",
      "to": "shift",
      "label": "シフトを組む",
      "cardinality": "1:N",
      "description": "1つのイベントに複数のスタッフがシフトとして割り当てられる。"
    },
    {
      "id": "r7",
      "from": "staff",
      "to": "shift",
      "label": "担当する",
      "cardinality": "1:N",
      "description": "1人のスタッフが複数のイベントのシフトに入りうる。"
    }
  ],
  "constraints": [
    {
      "entity": "performance",
      "attribute": "出演形態",
      "type": "enum",
      "values": ["招待", "ノルマ"]
    },
    {
      "entity": "ticket_type",
      "attribute": "種別名",
      "type": "enum",
      "values": ["直販", "eチケット", "取り置き"]
    },
    {
      "entity": "ticket_sale",
      "attribute": "販売枚数",
      "type": "check",
      "rule": "0枚以上"
    }
  ],
